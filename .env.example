# Upstash Redis DB "JHG-Compass" — same two values as the Vercel project. Never commit.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Firebase Admin (same service-account JSON as Vercel, base64 one line) — Firestore mirror + Storage.
FIREBASE_SERVICE_ACCOUNT_B64=
FIREBASE_STORAGE_BUCKET=jhg-compass.firebasestorage.app

# Where things live on the Pi
CAREER_OPS_REPO=/home/rafcasto/career-ops          # clean upstream checkout (system layer)
CAREEROPS_DATA_BASE=/home/rafcasto/careerops-data  # per-member roots: <base>/<uid>/
CAREEROPS_TRAINING_DIR=/home/rafcasto/careerops-training

# Local services
N8N_URL=http://127.0.0.1:5678
OLLAMA_BASE_URL=http://127.0.0.1:11434
JOB_SCRAPER_URL=http://127.0.0.1:3010

# Training machine (ssh alias from ~/.ssh/config); not always on — probed, never assumed
GPU_SSH_HOST=gpu

# Optional — only for the generate_gold job (Claude as the teacher). Lives on the Pi only.
ANTHROPIC_API_KEY=

# Tuning
POLL_MS=3000
WORKER_ID=
