[Unit]
Description=JHG Compass career-ops worker (Upstash queue -> n8n/Ollama agents)
After=network-online.target ollama.service n8n.service
Wants=network-online.target

[Service]
WorkingDirectory=%h/careerops-worker
EnvironmentFile=-%h/careerops-worker/.env
Environment=PATH=%h/.nvm/versions/node/v24.21.0/bin:%h/.local/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=%h/.nvm/versions/node/v24.21.0/bin/node worker.js
Restart=always
RestartSec=10

[Install]
WantedBy=default.target
